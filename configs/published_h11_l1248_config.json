{
  "_note": "Portable summary of the completed H11 L1248 configuration. The audited run bundles additionally lock file hashes, sampler schedules, checkpoints, and target-access records.",
  "experiment_name": "published_h11_l1248",
  "mode": "dg_loeo",
  "target_env": "all",
  "device": "cuda:0",
  "output_root": "outputs_h11_l1248",
  "seed_list": [42, 52, 62],
  "data": {
    "format": "env_npy_triplets",
    "unwrap_phase": true,
    "phase_unwrap_axis": -1,
    "env_files": {
      "E1": {
        "amp": "data/MultiEnv/data_6c_1.npy",
        "phase": "data/MultiEnv/data_angle_6c_1.npy",
        "label": "data/MultiEnv/label_6c_1.npy"
      },
      "E2": {
        "amp": "data/MultiEnv/data_6c_2.npy",
        "phase": "data/MultiEnv/data_angle_6c_2.npy",
        "label": "data/MultiEnv/label_6c_2.npy"
      },
      "E3": {
        "amp": "data/MultiEnv/data_6c_3.npy",
        "phase": "data/MultiEnv/data_angle_6c_3.npy",
        "label": "data/MultiEnv/label_6c_3.npy"
      }
    }
  },
  "split": {
    "val_ratio": 0.2,
    "test_ratio": 0.2
  },
  "model": {
    "name": "isolated_pa_csi_dg_lite_tpp",
    "time_downsample": 2,
    "max_positions": 500,
    "position_kernels": 10,
    "mcat_layers": 5,
    "mcat_heads": 9,
    "temporal_kernel_num": 128,
    "temporal_kernel_sizes": [20, 40],
    "channel_group_width": 30,
    "channel_encoder_layers": 1,
    "channel_encoder_heads": 6,
    "channel_kernel_num": 16,
    "channel_kernel_sizes": [2, 4],
    "fusion_dim": 256,
    "projection_hidden_dim": 256,
    "projection_dim": 128,
    "dropout": 0.1,
    "antenna_layout": {
      "mode": "tx",
      "num_rx": 1,
      "num_tx": 3,
      "num_subcarriers": 30
    },
    "tpp_levels": [1, 2, 4, 8],
    "tpp_pool_type": "max",
    "tpp_preserve_global": true,
    "tpp_pyramid_scale": 0.25
  },
  "training": {
    "epochs": 200,
    "batch_size": 32,
    "lr": 0.001,
    "optimizer": "adam",
    "lr_scheduler": {
      "name": "exponential_decay",
      "update": "step",
      "decay_rate": 0.9,
      "decay_steps": 10000,
      "staircase": false
    },
    "weight_decay": 0.0,
    "patience": 200,
    "selection_metric": "accuracy",
    "sampler": "domain_class_balanced",
    "num_workers": 0,
    "domain_balanced_batch": false,
    "grad_clip_norm": 0.0
  },
  "losses": {
    "contrastive_loss_type": "pairwise_supcon",
    "temperature": 0.2,
    "lambda_supcon": 0.05,
    "lambda_supcon_warmup_epochs": 0,
    "include_same_domain_same_class": true,
    "supcon_positive_mode": "global_class_instance_views"
  },
  "factorial": {
    "name": "Factorial-S32",
    "arm": "H11",
    "tpp_on": true,
    "supcon_on": true,
    "classifier_representation": "dual_stream_residual025_tpp",
    "supcon_views": 4,
    "fully_coupled_tpp_views": true
  },
  "evaluation": {
    "save_confusion_matrix": true
  }
}
