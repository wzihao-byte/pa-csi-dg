    "status": "design_only_not_executable_frozen_config",
    "name": "MA_authorcode_DG_corrected_optimizer_v1",
    "interface": "train_source(model,source_train_manifest,source_val_manifest,sampler_schedule,optimizer_updates=30000); separate evaluate_frozen(checkpoint,test_manifest)",
