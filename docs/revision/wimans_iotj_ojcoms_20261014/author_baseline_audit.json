        "neck"
      ],
      "classifier_group": [
        "classifier"
      ],
      "betas": [
        0.9,
        0.999
      ]
    },
    "architecture_and_loss": "retain upstream ResNet, neck classification, all-view CE, beta mix, temperature/base-temperature scale, dynamic detached multiplier and within-batch style randomization; add neck to optimizer_f and zero its gradient every update",
    "neck_policy_disclosure_required": true,
    "author_release_fixed_neck_variant": "separate explicitly named variant only; do not select optimizer semantics by target score",
