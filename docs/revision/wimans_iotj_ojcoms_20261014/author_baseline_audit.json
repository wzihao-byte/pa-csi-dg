    ],
    "full_label_configuration": {
      "method": "UniCrossFi_dg",
      "ratio": null
    },
    "supervision_budget": "all source train labels; source validation labels for checkpoint selection; no pseudo-label branch in this class",
    "backbone": "shared 2D ResNet BasicBlock [2,2,2,2], input channels=2, output dimension=512",
    "neck": "Linear(512,512), ReLU, Linear(512,128), L2 normalization",
    "classifier": "Linear(128,6) over normalized neck embedding; same head for each view",
    "loss": {
      "ce": "mean_v cross_entropy(logits[:,v,:],y)",
      "contrast": "beta*SupCon(emb,y)+(1-beta)*SupCon(emb)",
      "dynamic_scale": "min(scale_cap, L_con.detach()/(L_ce.detach()+1e-6))",
      "total": "L_ce + dynamic_scale*L_con",
      "base_temperature": 0.07,
      "supcon_positive_policy": "class-equality tiled across all view pairs; self comparisons removed",
      "ucon_positive_policy": "same instance across all view pairs; self comparisons removed"
    },
    "widar_path_views": {
      "train": "two receiver-ratio views plus one randomized feature view",
      "inference": "mean of two per-view probabilities"
    },
    "style_randomization": "batch randperm of global 512-D feature means/stds, uniform interpolation; domain labels unused",
    "optimizer": "two Adam optimizers for feature_extractor and classifier; neck omitted",
    "schedule": "CosineAnnealingLR(eta_min=0,T_max=100*max(len(train_loader),len(test_loader))) stepped per update",
    "training_budget": "finite source DataLoader traversals until config.epochs or early-stop; not 30000 locked updates",
    "source_validation": "random 20% sample holdout seed=0; no subject/acquisition grouping",
    "checkpoint_rule": "validation accuracy >= current best selects last tied best; reload before final test",
    "target_access": [
      "Widar target paths and labels enumerated before train",
      "test_loader length enters scheduler and logged training loss denominator",
      "DG update uses only source minibatch; test data prediction after checkpoint reload",
      "CSIDA sibling loader eagerly loads target tensors and fits independent target min/max; must not be reused"
    ]
  },
  "input_audit": {
    "widar_preprocessing_code": "data/TD_CSI_process_widar.py",
